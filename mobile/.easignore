# Reduce EAS upload size by excluding generated and local-only files

# Dependency and package manager caches
node_modules/

# Expo local artifacts
.expo/

# Entire native folders are generated during managed EAS builds
android/
ios/

# Android generated outputs and caches
android/.gradle/
android/build/
android/app/build/

# iOS generated outputs and caches
ios/build/

# Logs and temporary files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
eas-log-*.txt
*.apk

# Local environment files
.env.local
.env.development.local
.env.test.local
.env.production.local

# Ignore other project folders at the root
../frontend/
../server/
../node_modules/
